# PowerSync Local Development
# Copy to .env and adjust for your local setup:
#   cp .env.example .env

PS_PORT=8585

# Local development (macOS with Homebrew PostgreSQL, no password)
PS_DATABASE_URL=postgresql://YOUR_USER@host.docker.internal:5432/orchestra_web?sslmode=disable
PS_STORAGE_URL=postgresql://YOUR_USER@host.docker.internal:5432/powersync_storage?sslmode=disable
PS_JWKS_URL=http://host.docker.internal:8080/api/powersync/keys

# Production (update with real credentials)
# PS_DATABASE_URL=postgresql://orchestra:SECURE_PASSWORD@localhost:5432/orchestra_web?sslmode=disable
# PS_STORAGE_URL=postgresql://orchestra:SECURE_PASSWORD@localhost:5432/powersync_storage?sslmode=disable
# PS_JWKS_URL=http://localhost:8080/api/powersync/keys
